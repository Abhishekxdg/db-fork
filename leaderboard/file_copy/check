#!/bin/bash
# Exit 0 only if the PostgreSQL process that start launched is alive and the
# adapter's port answers as a PostgreSQL server.
set -euo pipefail

runs="$(cd "$(dirname "$0")/.." && pwd)/.runs"
[ -f "$runs/file_copy.pid" ] && kill -0 "$(cat "$runs/file_copy.pid")" 2>/dev/null || exit 1

"${PYTHON:-python3}" - <<'EOF'
import os

import psycopg2
from psycopg2.extensions import ISOLATION_LEVEL_AUTOCOMMIT

conn = psycopg2.connect(
    host=os.environ.get("PGSQL_HOST", "localhost"),
    port=int(os.environ.get("PGSQL_PORT", "5433")),
    user=os.environ.get("PGSQL_USER", os.environ.get("USER", "postgres")),
    password=os.environ.get("PGSQL_PASSWORD", ""),
    dbname="postgres",
    connect_timeout=2,
)
conn.set_isolation_level(ISOLATION_LEVEL_AUTOCOMMIT)
with conn.cursor() as cur:
    cur.execute("SELECT current_setting('server_version')")
    cur.execute(
        "DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'postgres') "
        "THEN CREATE ROLE postgres WITH SUPERUSER LOGIN; END IF; END $$;"
    )
conn.close()
EOF
